<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/topLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="30sp"
        android:layout_marginTop="20sp">
        <TextView
            android:textSize="18sp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Bass Interval"
            android:layout_weight="1"/>
        <TextView
            android:textSize="18sp"
            android:gravity="right"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Treble Interval"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="65sp">
        <Spinner
            android:id="@+id/bass"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <Spinner
            android:id="@+id/treble"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textColor="#ffffffff"
            android:background="@drawable/roundedbuttonlight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Make Default"
            android:onClick="makeDefButtonOnClick"/>
        <Button
            android:textColor="#ffffffff"
            android:background="@drawable/roundedbuttonlight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40sp"
            android:text="Done"
            android:onClick="doneButtonOnClick"/>
    </LinearLayout>
</LinearLayout>
