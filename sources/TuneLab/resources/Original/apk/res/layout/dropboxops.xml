<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/topLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100sp"
        android:layout_marginTop="20sp"
        android:layout_marginBottom="15sp">
        <ImageButton
            android:id="@+id/copy2dropbox"
            android:background="@null"
            android:layout_width="100sp"
            android:layout_height="100sp"
            android:src="@drawable/upload"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:onClick="onClickCopyToDropbox"/>
        <TextView
            android:textSize="14sp"
            android:gravity="center_horizontal"
            android:id="@+id/uploadtxt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="10sp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100sp">
        <ImageButton
            android:id="@+id/copyFromdropbox"
            android:background="@null"
            android:layout_width="100sp"
            android:layout_height="100sp"
            android:src="@drawable/download"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:onClick="onClickDownloadFromDropbox"/>
        <TextView
            android:textSize="14sp"
            android:gravity="center_horizontal"
            android:id="@+id/downloadtxt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="10sp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="90sp"
        android:layout_marginTop="15sp">
        <ImageButton
            android:id="@+id/unlink"
            android:background="@null"
            android:layout_width="70sp"
            android:layout_height="70sp"
            android:layout_marginLeft="30sp"
            android:src="@drawable/unlink"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:onClick="onClickLinkUnlink"/>
        <TextView
            android:textSize="14sp"
            android:gravity="center_horizontal"
            android:id="@+id/unlinktxt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="10sp"/>
    </LinearLayout>
</LinearLayout>
