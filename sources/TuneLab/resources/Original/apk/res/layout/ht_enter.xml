<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/topLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:padding="8dp"
                android:text="Temperament Name:"/>
            <EditText
                android:id="@+id/tempName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TableRow>
                <TextView
                    android:textSize="18sp"
                    android:gravity="right"
                    android:text="Offset for A  "/>
                <EditText
                    android:id="@+id/offset0"
                    android:layout_width="100sp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"/>
            </TableRow>
            <TableRow>
                <TextView
                    android:textSize="18sp"
                    android:gravity="right"
                    android:text="Offset for A# "/>
                <EditText
                    android:id="@+id/offset1"
                    android:layout_width="100sp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"/>
            </TableRow>
            <TableRow>
                <TextView
                    android:textSize="18sp"
                    android:gravity="right"
                    android:text="Offset for B  "/>
                <EditText
                    android:id="@+id/offset2"
                    android:layout_width="100sp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"/>
            </TableRow>
            <TableRow>
                <TextView
                    android:textSize="18sp"
                    android:gravity="right"
                    android:text="Offset for C  "/>
                <EditText
                    android:id="@+id/offset3"
                    android:layout_width="100sp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"/>
            </TableRow>
            <TableRow>
                <TextView
                    android:textSize="18sp"
                    android:gravity="right"
                    android:text="Offset for C# "/>
                <EditText
                    android:id="@+id/offset4"
                    android:layout_width="100sp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"/>
            </TableRow>
            <TableRow>
                <TextView
                    android:textSize="18sp"
                    android:gravity="right"
                    android:text="Offset for D  "/>
                <EditText
                    android:id="@+id/offset5"
                    android:layout_width="100sp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"/>
            </TableRow>
            <TableRow>
                <TextView
                    android:textSize="18sp"
                    android:gravity="right"
                    android:text="Offset for D# "/>
                <EditText
                    android:id="@+id/offset6"
                    android:layout_width="100sp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"/>
            </TableRow>
            <TableRow>
                <TextView
                    android:textSize="18sp"
                    android:gravity="right"
                    android:text="Offset for E  "/>
                <EditText
                    android:id="@+id/offset7"
                    android:layout_width="100sp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"/>
            </TableRow>
            <TableRow>
                <TextView
                    android:textSize="18sp"
                    android:gravity="right"
                    android:text="Offset for F  "/>
                <EditText
                    android:id="@+id/offset8"
                    android:layout_width="100sp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"/>
            </TableRow>
            <TableRow>
                <TextView
                    android:textSize="18sp"
                    android:gravity="right"
                    android:text="Offset for F# "/>
                <EditText
                    android:id="@+id/offset9"
                    android:layout_width="100sp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"/>
            </TableRow>
            <TableRow>
                <TextView
                    android:textSize="18sp"
                    android:gravity="right"
                    android:text="Offset for G  "/>
                <EditText
                    android:id="@+id/offset10"
                    android:layout_width="100sp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"/>
            </TableRow>
            <TableRow>
                <TextView
                    android:textSize="18sp"
                    android:gravity="right"
                    android:text="Offset for G# "/>
                <EditText
                    android:id="@+id/offset11"
                    android:layout_width="100sp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"/>
            </TableRow>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:textSize="20sp"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/roundedbuttonlight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="5sp"
                    android:text=" Cancel "
                    android:onClick="onCancelButton"/>
                <Button
                    android:textSize="20sp"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/roundedbuttonlight"
                    android:layout_width="100sp"
                    android:layout_height="wrap_content"
                    android:layout_margin="5sp"
                    android:text=" Save "
                    android:onClick="onSaveButton"/>
            </LinearLayout>
        </TableLayout>
    </ScrollView>
</LinearLayout>
