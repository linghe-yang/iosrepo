<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/topLayout"
    android:background="#334466"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageButton
        android:id="@+id/help_combined"
        android:background="@drawable/help"
        android:clickable="true"
        android:layout_width="48sp"
        android:layout_height="48sp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="30dp"
        android:scaleType="fitCenter"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Switch
        android:textSize="26sp"
        android:id="@+id/combined_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:textOn="combined"
        android:textOff="separate"
        android:onClick="onClickSwitch"
        app:layout_constraintBottom_toBottomOf="@+id/help_combined"
        app:layout_constraintLeft_toRightOf="@+id/help_combined"/>
    <Spinner
        android:id="@+id/topnote_mpar"
        android:background="#226622"
        android:layout_width="80sp"
        android:layout_height="60sp"
        android:layout_marginTop="10sp"
        app:layout_constraintLeft_toLeftOf="@+id/combined_switch"
        app:layout_constraintTop_toBottomOf="@+id/combined_switch"/>
    <ImageButton
        android:id="@+id/help_topnote"
        android:background="@drawable/help"
        android:clickable="true"
        android:layout_width="48sp"
        android:layout_height="48sp"
        android:scaleType="fitCenter"
        app:layout_constraintLeft_toLeftOf="@+id/help_combined"
        app:layout_constraintTop_toTopOf="@+id/topnote_mpar"/>
    <TextView
        android:textSize="20sp"
        android:textColor="#ffffff"
        android:id="@+id/topnotecaption"
        android:background="#226622"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10sp"
        android:text="highest note in\10multi-partials"
        app:layout_constraintBottom_toBottomOf="@+id/topnote_mpar"
        app:layout_constraintLeft_toRightOf="@+id/topnote_mpar"
        app:layout_constraintTop_toTopOf="@+id/topnote_mpar"/>
    <ImageButton
        android:id="@+id/exit_button"
        android:background="@drawable/exit"
        android:layout_width="48sp"
        android:layout_height="48sp"
        android:layout_marginTop="10dp"
        android:scaleType="fitCenter"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/help_combined"/>
</androidx.constraintlayout.widget.ConstraintLayout>
