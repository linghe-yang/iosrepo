<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/topLayout"
    android:background="#ff000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="18sp"
        android:textColor="#ffffffff"
        android:layout_width="wrap_content"
        android:layout_height="30sp"
        android:text="Pick temperament octave"/>
    <Spinner
        android:textColor="#ffffffff"
        android:id="@+id/spinner"
        android:background="#ff183818"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#ffffffff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Before being evaluated against a master tuning, the current tuning will be adjusted so that the difference between it and the master tuning averges to zero in this chosen octave"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#ffffffff"
        android:gravity="bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="When you are satisfied that the desired temperament octave has been selected, tap below to select the master tuning that will be used to evaluate the current tuning"
        android:layout_weight="1"/>
    <Button
        android:textColor="#ffffffff"
        android:layout_gravity="bottom"
        android:background="@drawable/roundedbuttonlight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Continue (pick master)"
        android:onClick="onClickPickMaster"/>
</LinearLayout>
