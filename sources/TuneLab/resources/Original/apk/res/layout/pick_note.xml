<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/topLayout"
    android:background="#ff88aa88"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:background="#ff000000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textSize="20sp"
            android:textColor="#ffffff"
            android:layout_gravity="center_horizontal"
            android:id="@+id/oct0"
            android:background="#ff000000"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="0"
            android:layout_weight="0.2"
            android:onClick="octaveOnClick"/>
        <Button
            android:textSize="20sp"
            android:textColor="#ffffff"
            android:layout_gravity="center_horizontal"
            android:id="@+id/oct1"
            android:background="#ff000000"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="1"
            android:layout_weight="0.2"
            android:onClick="octaveOnClick"/>
        <Button
            android:textSize="20sp"
            android:textColor="#ffffff"
            android:layout_gravity="center_horizontal"
            android:id="@+id/oct2"
            android:background="#ff000000"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="2"
            android:layout_weight="0.2"
            android:onClick="octaveOnClick"/>
        <Button
            android:textSize="20sp"
            android:textColor="#ffffff"
            android:layout_gravity="center_horizontal"
            android:id="@+id/oct3"
            android:background="#ff000000"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="3"
            android:layout_weight="0.2"
            android:onClick="octaveOnClick"/>
        <Button
            android:textSize="20sp"
            android:textColor="#ffffff"
            android:layout_gravity="center_horizontal"
            android:id="@+id/oct4"
            android:background="#ff000000"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="4"
            android:layout_weight="0.2"
            android:onClick="octaveOnClick"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="#ff000000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textSize="20sp"
            android:textColor="#ffffff"
            android:layout_gravity="center_horizontal"
            android:id="@+id/oct5"
            android:background="#ff000000"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="5"
            android:layout_weight="0.2"
            android:onClick="octaveOnClick"/>
        <Button
            android:textSize="20sp"
            android:textColor="#ffffff"
            android:layout_gravity="center_horizontal"
            android:id="@+id/oct6"
            android:background="#ff000000"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="6"
            android:layout_weight="0.2"
            android:onClick="octaveOnClick"/>
        <Button
            android:textSize="20sp"
            android:textColor="#ffffff"
            android:layout_gravity="center_horizontal"
            android:id="@+id/oct7"
            android:background="#ff000000"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="7"
            android:layout_weight="0.2"
            android:onClick="octaveOnClick"/>
        <Button
            android:textSize="20sp"
            android:textColor="#ffffff"
            android:layout_gravity="center_horizontal"
            android:id="@+id/oct8"
            android:background="#ff000000"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="8"
            android:layout_weight="0.2"
            android:onClick="octaveOnClick"/>
    </LinearLayout>
    <TextView
        android:textSize="20sp"
        android:textColor="#ffffff"
        android:gravity="center_horizontal"
        android:background="#ff000000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="octave selection"/>
    <TextView
        android:textSize="20sp"
        android:textColor="#ff000000"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10sp"
        android:text="note selection"/>
    <com.realtimespecialties.tunelab.PickNoteV
        android:id="@+id/pickNoteView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
