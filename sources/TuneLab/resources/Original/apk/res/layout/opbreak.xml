<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/topLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="65sp"
        android:layout_marginTop="10sp">
        <Spinner
            android:id="@+id/bass"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.4"/>
        <TextView
            android:textSize="16sp"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="Highest note on\10the base bridge"
            android:layout_weight="0.6"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="65sp"
        android:layout_marginTop="10sp">
        <Spinner
            android:id="@+id/wound"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.4"/>
        <TextView
            android:textSize="16sp"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="Highest note with\10wound strings"
            android:layout_weight="0.6"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="65sp"
        android:layout_marginTop="10sp">
        <Spinner
            android:id="@+id/strut1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.4"/>
        <TextView
            android:textSize="16sp"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="First treble strut"
            android:layout_weight="0.6"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="65sp"
        android:layout_marginTop="10sp">
        <Spinner
            android:id="@+id/strut2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.4"/>
        <TextView
            android:textSize="16sp"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="Second treble strut"
            android:layout_weight="0.6"/>
    </LinearLayout>
    <Button
        android:textColor="#ffffffff"
        android:background="@drawable/roundedbuttonlight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10sp"
        android:text="Done"
        android:onClick="doneOnClick"/>
</LinearLayout>
