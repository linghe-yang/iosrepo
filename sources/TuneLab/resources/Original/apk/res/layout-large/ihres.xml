<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/topLayout"
    android:background="#ffc0e0c0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="18sp"
                android:textColor="#ff000000"
                android:gravity="left"
                android:background="#ffddeedd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Partial"
                android:layout_weight="1"/>
            <TextView
                android:textSize="18sp"
                android:textColor="#ff000000"
                android:gravity="center_horizontal"
                android:background="#ffddeedd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Offset"
                android:layout_weight="1"/>
            <TextView
                android:textSize="18sp"
                android:textColor="#ff000000"
                android:gravity="center_horizontal"
                android:id="@+id/ampheading"
                android:background="#ffddeedd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Amp"
                android:layout_weight="1"/>
        </LinearLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="77">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/listLayout"
                android:background="#ffcceecc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_weight="2">
        <TextView
            android:textSize="30sp"
            android:textColor="#ff000000"
            android:gravity="center_horizontal"
            android:id="@+id/forNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="For: C#5"
            android:layout_weight="1"/>
        <Button
            android:textSize="24sp"
            android:textColor="#ff000000"
            android:layout_gravity="center_horizontal"
            android:id="@+id/delPrior"
            android:background="#ffffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete Prior"
            android:onClick="deletePriorButtonOnClick"/>
        <TextView
            android:textSize="30sp"
            android:textColor="#ff000000"
            android:gravity="center_horizontal"
            android:id="@+id/priorAvg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prior Avg. = 0.215"
            android:layout_weight="1"/>
        <TextView
            android:textSize="30sp"
            android:textColor="#ff000000"
            android:gravity="center_horizontal"
            android:id="@+id/ihCon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IH.Con=9.650"
            android:layout_weight="1"/>
        <Button
            android:textSize="24sp"
            android:textColor="#ff000000"
            android:layout_gravity="center_horizontal"
            android:id="@+id/save"
            android:background="#ffffffff"
            android:layout_width="200sp"
            android:layout_height="wrap_content"
            android:text="Save"
            android:onClick="saveButtonOnClick"/>
        <Button
            android:textSize="24sp"
            android:textColor="#ff000000"
            android:layout_gravity="center_horizontal"
            android:id="@+id/savePlus"
            android:background="#ffffffff"
            android:layout_width="200sp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10sp"
            android:text="Save,+"
            android:onClick="savePlusButtonOnClick"/>
        <Button
            android:textSize="24sp"
            android:textColor="#ff000000"
            android:layout_gravity="center_horizontal"
            android:background="#ffffffff"
            android:layout_width="200sp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10sp"
            android:layout_marginBottom="10sp"
            android:text="Discard"
            android:onClick="discardButtonOnClick"/>
    </LinearLayout>
</LinearLayout>
