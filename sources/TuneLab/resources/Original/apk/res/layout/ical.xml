<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/topLayout"
    android:background="#ffcccccc"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="#ff000000"
        android:gravity="center_vertical"
        android:id="@+id/instructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="To start ... "
        android:layout_weight="1"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60sp">
        <Button
            android:textSize="18sp"
            android:textColor="#ff000000"
            android:id="@+id/cancelButton"
            android:background="#ffffaaaa"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="6sp"
            android:layout_marginRight="6sp"
            android:text="Cancel the Calibration"
            android:layout_weight="0.5"
            android:keepScreenOn="true"
            android:onClick="onClickCancel"/>
        <Button
            android:textSize="18sp"
            android:textColor="#ff000000"
            android:id="@+id/beginButton"
            android:background="#ffaaffaa"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="6sp"
            android:layout_marginRight="6sp"
            android:text="Begin the Calibration"
            android:layout_weight="0.5"
            android:onClick="onClickBegin"/>
    </LinearLayout>
    <Button
        android:textColor="#ff000000"
        android:layout_gravity="center_horizontal"
        android:id="@+id/defButton"
        android:background="#ffeeaa88"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="6sp"
        android:text="Revert to default calibration"
        android:onClick="onClickDef"/>
    <TextView
        android:textColor="#ff000000"
        android:id="@+id/stat1"
        android:background="#ffcceeff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="2sp"
        android:text="----"/>
    <TextView
        android:textColor="#ff000000"
        android:id="@+id/stat2"
        android:background="#ffcceeff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="2sp"
        android:text="----"/>
    <TextView
        android:textColor="#ff000000"
        android:id="@+id/stat3"
        android:background="#ffcceeff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="2sp"
        android:text="----"/>
    <TextView
        android:textColor="#ff000000"
        android:id="@+id/stat4"
        android:background="#ffcceeff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="2sp"
        android:text="----"/>
    <TextView
        android:textColor="#ff000000"
        android:id="@+id/stat5"
        android:background="#ffcceeff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="2sp"
        android:text="----"/>
</LinearLayout>
