<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/topLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3-part tuning setup"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20sp">
            <TextView
                android:textSize="18sp"
                android:id="@+id/basstext"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="Bass"
                android:layout_weight="1"/>
            <Spinner
                android:id="@+id/bass"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5sp">
            <TextView
                android:textSize="18sp"
                android:gravity="left"
                android:id="@+id/midtext"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="Middle"
                android:layout_weight="1"/>
            <Spinner
                android:id="@+id/middle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:gravity="left"
                android:id="@+id/midloctext"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="Middle at:"
                android:layout_weight="2"/>
            <Spinner
                android:id="@+id/midloc"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5sp">
            <TextView
                android:textSize="18sp"
                android:gravity="left"
                android:id="@+id/trebletext"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="Treble"
                android:layout_weight="1"/>
            <Spinner
                android:id="@+id/treble"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10sp">
            <Button
                android:textColor="#ffffffff"
                android:background="@drawable/roundedbuttonlight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Make Default "
                android:onClick="makeDefButtonOnClick"/>
            <Button
                android:textColor="#ffffffff"
                android:id="@+id/done"
                android:background="@drawable/roundedbuttonlight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="40sp"
                android:text="Done"
                android:onClick="doneButtonOnClick"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
