<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/topLayout"
    android:background="#116644"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:background="#000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10sp">
            <TextView
                android:textSize="16sp"
                android:textColor="#44bbff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="6sp"
                android:text="Pre-measuring: . . . . . . . . . ."/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="55sp">
                <ImageButton
                    android:id="@+id/beginResumeHelpButton"
                    android:background="@android:color/transparent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:src="@drawable/help37"
                    android:layout_alignParentRight="true"
                    android:onClick="onClick"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toLeftOf="@+id/beginResumeHelpButton"
                    android:layout_alignParentLeft="true">
                    <Button
                        android:textSize="16sp"
                        android:textColor="#ffffffff"
                        android:id="@+id/beginPreButton"
                        android:background="@drawable/roundedbuttonlight"
                        android:layout_width="0px"
                        android:layout_height="45sp"
                        android:layout_marginRight="5sp"
                        android:text="Start"
                        android:singleLine="false"
                        android:layout_weight="10"
                        android:layout_alignParentLeft="true"
                        android:onClick="onClick"/>
                    <Button
                        android:textSize="16sp"
                        android:textColor="#ffffffff"
                        android:id="@+id/resumeButton"
                        android:background="@drawable/roundedbuttonlight"
                        android:layout_width="0px"
                        android:layout_height="45sp"
                        android:layout_marginLeft="5sp"
                        android:text="Resume"
                        android:layout_weight="10"
                        android:layout_toLeftOf="@+id/beginResumeHelpButton"
                        android:onClick="onClick"/>
                </LinearLayout>
            </RelativeLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageButton
                    android:id="@+id/adjPreMethod"
                    android:background="@android:color/transparent"
                    android:padding="5px"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/wrench37"
                    android:layout_weight="1"
                    android:onClick="onClick"/>
                <TextView
                    android:textSize="16sp"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/preMethod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pre-measure C, E, G, etc."
                    android:layout_weight="22"/>
            </LinearLayout>
            <Button
                android:textSize="14sp"
                android:textColor="#ffffffff"
                android:layout_gravity="center_horizontal"
                android:id="@+id/editPre"
                android:background="@drawable/roundedbuttonlight"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="35sp"
                android:text="Edit pre-measurements"
                android:singleLine="false"
                android:onClick="onClick"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="#000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10sp">
            <TextView
                android:textSize="16sp"
                android:textColor="#44bbff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="6sp"
                android:text="Over-pull tuning: . . . . . . . . . ."/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="50sp">
                <ImageButton
                    android:id="@+id/beginTuneHelpButton"
                    android:background="@android:color/transparent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:src="@drawable/help37"
                    android:layout_alignParentRight="true"
                    android:onClick="onClick"/>
                <Button
                    android:textSize="16sp"
                    android:textColor="#ffffffff"
                    android:id="@+id/beginTuneButton"
                    android:background="@drawable/roundedbuttonlight"
                    android:layout_width="match_parent"
                    android:layout_height="35sp"
                    android:text="Begin tuning with over-pull"
                    android:singleLine="false"
                    android:layout_toLeftOf="@+id/beginTuneHelpButton"
                    android:layout_alignParentLeft="true"
                    android:onClick="onClick"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageButton
                    android:id="@+id/adjBassUpTo"
                    android:background="@android:color/transparent"
                    android:padding="5px"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/wrench37"
                    android:layout_weight="1"
                    android:onClick="onClick"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/bassBridgeUpTo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bass Bridge goes up to A#2\10Wound strings go up to C3\10Treble struts not specified"
                    android:layout_weight="22"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageButton
                    android:id="@+id/adjBassSafetyLimit"
                    android:background="@android:color/transparent"
                    android:padding="5px"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/wrench37"
                    android:layout_weight="1"
                    android:onClick="onClick"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/bassSafetyLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Limit over-pull for wound strings to 10 cents."
                    android:layout_weight="22"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageButton
                    android:id="@+id/adjTrebleSafetyLimit"
                    android:background="@android:color/transparent"
                    android:padding="5px"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/wrench37"
                    android:layout_weight="1"
                    android:onClick="onClick"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/trebleSafetyLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Limit over-pull for plain strings to 10 cents."
                    android:layout_weight="22"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageButton
                    android:id="@+id/adjOPfactor"
                    android:background="@android:color/transparent"
                    android:padding="5px"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/wrench37"
                    android:layout_weight="1"
                    android:onClick="onClick"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/OPfactor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Over-pull factor = ?"
                    android:layout_weight="22"/>
            </LinearLayout>
            <Button
                android:textColor="#ffffffff"
                android:background="@drawable/roundedbuttonlight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20sp"
                android:layout_marginTop="9sp"
                android:text=" Back to Main "
                android:onClick="mainOnClick"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
