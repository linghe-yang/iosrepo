<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/topLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="20sp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:layout_width="wrap_content"
            android:layout_height="90sp"
            android:layout_marginRight="5sp"
            android:text="Maximum allowed over-pull for wound strings"
            android:layout_weight="1"/>
        <TextView
            android:textSize="18sp"
            android:gravity="right"
            android:layout_width="wrap_content"
            android:layout_height="90sp"
            android:layout_marginLeft="5sp"
            android:text="Maximum allowed over-pull for plain strings"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Spinner
            android:id="@+id/bass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <Spinner
            android:id="@+id/treble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
    <Button
        android:textColor="#ffffffff"
        android:background="@drawable/roundedbuttonlight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Done"
        android:onClick="doneOnClick"/>
</LinearLayout>
