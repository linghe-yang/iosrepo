<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/topLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="18sp"
        android:paddingTop="10sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="5sp"
        android:text="Select a multiplier for the apparent speed of the Phase Display moving boxes.  Multipliers greater than 1.00 make the display more sensitive, but also more jittery."/>
    <Spinner
        android:id="@+id/phase_vel_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <Button
        android:textColor="#ffffffff"
        android:background="@drawable/roundedbuttonlight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20sp"
        android:layout_marginTop="20sp"
        android:text=" Back to Main "
        android:onClick="doneOnClick"/>
</LinearLayout>
