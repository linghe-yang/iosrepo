<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/topAnchor"
        android:layout_width="0px"
        android:layout_height="0px"/>
    <RelativeLayout
        android:id="@+id/rightSideLayout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true">
        <TextView
            android:textSize="15sp"
            android:textColor="#000000"
            android:gravity="right"
            android:id="@+id/customStretch"
            android:layout_width="120sp"
            android:layout_height="wrap_content"
            android:text="cust"
            android:layout_alignParentTop="true"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#000000"
            android:gravity="right"
            android:id="@+id/tcurve"
            android:layout_width="120sp"
            android:layout_height="wrap_content"
            android:text="tcurve"
            android:layout_below="@+id/customStretch"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#000000"
            android:gravity="right"
            android:id="@+id/temperOffset"
            android:layout_width="120sp"
            android:layout_height="wrap_content"
            android:text="temperOffset"
            android:layout_below="@+id/tcurve"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/buttonLayout1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <ImageButton
                android:id="@+id/speakerButton"
                android:background="@android:color/transparent"
                android:layout_width="65sp"
                android:layout_height="65sp"
                android:src="@drawable/speakerselector"
                android:scaleType="fitXY"
                android:layout_alignParentBottom="true"
                android:onClick="speakerButtonOnClick"/>
            <ImageButton
                android:id="@+id/settingsButton"
                android:background="@android:color/transparent"
                android:layout_width="65sp"
                android:layout_height="65sp"
                android:src="@drawable/gearsselector"
                android:scaleType="fitXY"
                android:layout_alignParentBottom="true"
                android:onClick="settingsButtonOnClick"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/buttonLayout2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/buttonLayout1">
            <ImageButton
                android:id="@+id/measureButton"
                android:background="@android:color/transparent"
                android:layout_width="65sp"
                android:layout_height="65sp"
                android:src="@drawable/rulerselector"
                android:scaleType="fitXY"
                android:layout_alignParentBottom="true"
                android:onClick="measureButtonOnClick"/>
            <ImageButton
                android:id="@+id/lockButton"
                android:background="@android:color/transparent"
                android:layout_width="65sp"
                android:layout_height="65sp"
                android:src="@drawable/lockselector"
                android:scaleType="fitXY"
                android:layout_alignParentBottom="true"
                android:onClick="lockButtonOnClick"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/buttonLayout2">
            <ImageButton
                android:id="@+id/tcurveButton"
                android:background="@android:color/transparent"
                android:layout_width="65sp"
                android:layout_height="65sp"
                android:src="@drawable/tuningcurveselector"
                android:scaleType="fitXY"
                android:layout_alignParentBottom="true"
                android:onClick="tcurveButtonOnClick"/>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toLeftOf="@+id/rightSideLayout">
        <RelativeLayout
            android:id="@+id/leftSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true">
            <TextView
                android:textSize="18sp"
                android:textColor="#000000"
                android:id="@+id/tuningFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="t-file"
                android:layout_alignParentTop="true"/>
            <TextView
                android:textSize="18sp"
                android:textColor="#000000"
                android:id="@+id/offset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="offset"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"/>
            <TextView
                android:textSize="18sp"
                android:textColor="#000000"
                android:id="@+id/temperament"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="temperament"
                android:layout_below="@+id/tuningFile"
                android:layout_alignParentLeft="true"/>
            <TextView
                android:textSize="18sp"
                android:textColor="#000000"
                android:id="@+id/autoNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="noteMode"
                android:layout_below="@+id/offset"
                android:layout_alignParentRight="true"/>
            <TextView
                android:textSize="18sp"
                android:textColor="#000000"
                android:id="@+id/freq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="freq"
                android:layout_below="@+id/temperament"
                android:layout_alignParentLeft="true"/>
            <TextView
                android:textSize="18sp"
                android:textColor="#000000"
                android:id="@+id/partial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="partial"
                android:layout_below="@+id/autoNote"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <com.realtimespecialties.tunelab.PhaseDisplayV
            android:id="@+id/phaseDisplay"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_below="@+id/leftSettings"
            android:layout_alignParentLeft="true"/>
        <ProgressBar
            android:id="@+id/blush"
            android:layout_width="85sp"
            android:layout_height="10sp"
            android:progressDrawable="@drawable/progressbar2"
            android:layout_below="@+id/phaseDisplay"
            android:layout_centerHorizontal="true"
            style="?android:attr/progressBarStyleHorizontal"/>
        <TextView
            android:textSize="38sp"
            android:textColor="#000000"
            android:gravity="center_horizontal"
            android:id="@+id/currentNote"
            android:layout_width="85sp"
            android:layout_height="55sp"
            android:text="A#6"
            android:layout_below="@+id/blush"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/leftStatusLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toLeftOf="@+id/currentNote"
            android:layout_below="@+id/phaseDisplay"
            android:layout_alignBottom="@+id/currentNote"
            android:layout_alignParentLeft="true">
            <TextView
                android:textSize="19sp"
                android:textColor="#000000"
                android:id="@+id/leftStatusTop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4sp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#000000"
                android:id="@+id/leftStatusBottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8sp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/rightStatusLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toRightOf="@+id/currentNote"
            android:layout_below="@+id/phaseDisplay"
            android:layout_alignBottom="@+id/currentNote"
            android:layout_alignParentRight="true">
            <TextView
                android:textSize="16sp"
                android:textColor="#000000"
                android:gravity="center_horizontal"
                android:id="@+id/rightStatusTop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2sp"
                android:singleLine="false"
                android:layout_weight="2"/>
            <TextView
                android:textSize="20sp"
                android:textColor="#000000"
                android:gravity="center_horizontal"
                android:id="@+id/rightStatusBottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="false"
                android:layout_weight="1"/>
        </LinearLayout>
        <com.realtimespecialties.tunelab.SpectrumDisplayV
            android:id="@+id/spectrumDisplay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/currentNote"
            android:layout_alignParentLeft="true"/>
    </RelativeLayout>
</RelativeLayout>
