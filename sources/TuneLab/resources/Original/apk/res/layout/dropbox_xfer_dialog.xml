<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/topLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="20sp"
        android:textColor="#ff000000"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/heading"
        android:background="#ffc0c0ff"
        android:layout_width="match_parent"
        android:layout_height="30sp"
        android:text="Download from Dropbox"/>
    <RadioGroup
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8sp">
        <RadioButton
            android:textSize="18sp"
            android:id="@+id/xferRecent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8sp"
            android:checked="true"
            android:text="Transfer only the more recently modified files."/>
        <RadioButton
            android:textSize="18sp"
            android:id="@+id/xferAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8sp"
            android:text="Transfer all files, regardless of when they were modified. (This could take more time.)"/>
        <RadioButton
            android:textSize="18sp"
            android:id="@+id/xferNdays"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10sp"
            android:layout_marginBottom="8sp"
            android:text="Transfer files less than N days old."
            android:onClick="onClickNdays"/>
    </RadioGroup>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/busy_image"
            android:background="@null"
            android:layout_width="41dp"
            android:layout_height="41dp"
            android:src="@drawable/busy1"
            android:adjustViewBounds="true"/>
        <TextView
            android:textSize="18sp"
            android:textColor="#000000"
            android:id="@+id/progress"
            android:background="#c0c0c0"
            android:layout_width="match_parent"
            android:layout_height="60sp"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15sp">
        <Button
            android:textSize="24sp"
            android:textColor="#000000"
            android:id="@+id/cancel"
            android:background="#ffa0a0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8sp"
            android:text=" Cancel "
            android:layout_alignParentLeft="true"
            android:onClick="onClickCancel"/>
        <CheckBox
            android:textSize="18sp"
            android:id="@+id/pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pause for info"
            android:layout_centerHorizontal="true"
            android:onClick="onClickPauseForInfo"/>
        <Button
            android:textSize="24sp"
            android:textColor="#000000"
            android:id="@+id/ok"
            android:background="#80ffa0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8sp"
            android:text=" OK "
            android:layout_alignParentRight="true"
            android:onClick="onClickOK"/>
    </RelativeLayout>
</LinearLayout>
