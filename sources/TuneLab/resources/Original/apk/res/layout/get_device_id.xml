<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/topLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="#ff112233"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffffff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Instructions for placing an order for a license for this software can be found at"/>
        <TextView
            android:textSize="18sp"
            android:textColor="#ff000000"
            android:gravity="center_horizontal"
            android:id="@+id/ordersWebsite"
            android:background="#ffe0ffe0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="www.tunelab-world.com/orders"/>
        <TextView
            android:textSize="16sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This page is only for those who cannot use the &apos;forever license&apos; because their device does not connect to the Internet to verify the license. For all others, go back to the previous page and enter your &apos;forever license&apos; there.\10\10The legacy license is based on the ID shown below.  This ID changes with each device, and when a device is factory-reset.  Therefore if you use the legacy licensing method you will need to send in this ID if the ID changes or you get a new device.  If you want to use this legacy licensing system, send the ID shown below to"/>
        <TextView
            android:textSize="18sp"
            android:textColor="#ff000000"
            android:gravity="center_horizontal"
            android:id="@+id/salesEmail"
            android:background="#ffe0ffe0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="sales@tunelab-world.com"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffffff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Here is your device ID:"/>
        <TextView
            android:textSize="18sp"
            android:textColor="#ffffffff"
            android:layout_gravity="center_horizontal"
            android:id="@+id/idString"
            android:background="#ff0000aa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="dev. id."/>
        <Button
            android:textColor="#ffffffff"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/roundedbuttonlight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Send now by e-mail "
            android:onClick="onSendButton"/>
    </LinearLayout>
</ScrollView>
