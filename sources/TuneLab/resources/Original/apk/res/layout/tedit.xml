<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/topLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0sp"
        android:layout_weight="0.6">
        <com.realtimespecialties.tunelab.TCurveV
            android:id="@+id/tcurve"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ff000000"
            android:id="@+id/detailv"
            android:background="#ffffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""/>
    </FrameLayout>
    <LinearLayout
        android:id="@+id/buttonLayout"
        android:paddingTop="2px"
        android:paddingBottom="2px"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/wrench"
            android:background="@android:color/transparent"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:src="@drawable/wrench57"
            android:layout_weight="1"
            android:layout_alignParentBottom="true"/>
        <ImageButton
            android:id="@+id/zoom"
            android:background="@android:color/transparent"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:src="@drawable/zoom57"
            android:layout_weight="1"
            android:layout_alignParentBottom="true"/>
        <ImageButton
            android:id="@+id/detailb"
            android:background="@android:color/transparent"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:src="@drawable/detail57"
            android:layout_weight="1"
            android:layout_alignParentBottom="true"/>
        <LinearLayout
            android:paddingLeft="40sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <Button
                android:textSize="18sp"
                android:textColor="#ff000000"
                android:gravity="center_horizontal"
                android:id="@+id/intsel"
                android:background="@drawable/white57"
                android:layout_width="57sp"
                android:layout_height="57sp"
                android:text="r:t"/>
        </LinearLayout>
    </LinearLayout>
    <com.realtimespecialties.tunelab.DCurveV
        android:id="@+id/dcurve"
        android:layout_width="match_parent"
        android:layout_height="0sp"
        android:layout_weight="0.4"/>
</LinearLayout>
