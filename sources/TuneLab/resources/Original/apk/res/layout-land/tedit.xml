<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/topLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <FrameLayout
            android:paddingBottom="2px"
            android:layout_width="match_parent"
            android:layout_height="0sp"
            android:layout_weight="0.7">
            <com.realtimespecialties.tunelab.TCurveV
                android:id="@+id/tcurve"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#ff000000"
                android:id="@+id/detailv"
                android:background="#ffffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""/>
        </FrameLayout>
        <com.realtimespecialties.tunelab.DCurveV
            android:id="@+id/dcurve"
            android:layout_width="match_parent"
            android:layout_height="0sp"
            android:layout_weight="0.3"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/buttonLayout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <ImageButton
            android:id="@+id/wrench"
            android:background="@android:color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/wrench57"
            android:layout_weight="1"/>
        <ImageButton
            android:id="@+id/zoom"
            android:background="@android:color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/zoom57"
            android:layout_weight="1"/>
        <ImageButton
            android:id="@+id/detailb"
            android:background="@android:color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/detail57"
            android:layout_weight="1"/>
        <LinearLayout
            android:paddingTop="10sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <Button
                android:textSize="18sp"
                android:textColor="#ff000000"
                android:gravity="center_horizontal"
                android:id="@+id/intsel"
                android:background="@drawable/white57"
                android:layout_width="57dp"
                android:layout_height="57dp"
                android:text="r:t"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
